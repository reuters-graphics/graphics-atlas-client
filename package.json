{
  "name": "@reuters-graphics/graphics-atlas-client",
  "version": "0.5.2",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "repository": "https://github.com/reuters-graphics/graphics-atlas-client",
  "author": "Jon McClure <jon.r.mcclure@gmail.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build:metadata": "npx ./bin/buildMetadata/index.js",
    "build": "rollup --config rollup.config.mjs",
    "prepare": "rollup --config rollup.config.mjs",
    "lint": "eslint lib/ bin/",
    "test": "mocha",
    "test:integration": "mocha test/integration --recursive",
    "docs:dev": "pnpm -C docs install && pnpm -C docs dev",
    "docs:build": "pnpm build && pnpm -C docs install && pnpm -C docs build"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@sindresorhus/slugify": "^1.1.2",
    "csv-parse": "^5.5.6",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "mocha": "^11.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-node-externals": "^8.0.0",
    "unzipper": "^0.12.0"
  },
  "dependencies": {},
  "peerDependencies": {
    "flag-icons": ">=7"
  },
  "peerDependenciesMeta": {
    "flag-icons": {
      "optional": true
    }
  }
}
